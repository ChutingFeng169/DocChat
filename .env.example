# ======================== Required ========================
# Your OpenAI API key (or any OpenAI-compatible API key)
OPENAI_API_KEY=sk-your-real-key-here

# ======================== Optional (defaults to OpenAI) ========================
# Base URL for any OpenAI-compatible API (e.g., Ollama, vLLM, local LLM)
# Default: https://api.openai.com/v1
# OPENAI_BASE_URL=https://api.openai.com/v1

# Embedding model name (must be compatible with the base URL provider)
# Default: text-embedding-3-small
# EMBEDDING_MODEL=text-embedding-3-small

# Chat/LLM model name (must be compatible with the base URL provider)
# Default: gpt-4o-mini
# LLM_MODEL=gpt-4o-mini